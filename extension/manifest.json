{
  "manifest_version": 3,
  "name": "FourSight: Degree Flowchart Planner",
  "short_name": "FourSight",
  "version": "2.0.0",
  "description": "Plan all four years of your degree on a prerequisite flowchart: UT Cockrell templates, or a plan built from any school's curriculum.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open FourSight",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "102"
}
